# =====================================================
# .env.example - Template (copy ke .env lalu isi value)
# =====================================================

# === Supabase ===
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# === MT5 ===
MT5_SYMBOL=XAUUSD
MT5_TIMEFRAMES=M1,M5
STRATEGY_TIMEFRAME=M1
MT5_CANDLE_COUNT=50

# === EMA ===
EMA_FAST=10
EMA_SLOW=20
EMA_OFFSET=-2

# === Filter Strategy Selection ===
# Pilih strategi filter utama yang akan digunakan: A (Scoring/Grade) atau B (Pullback Limit, no Grade)
ACTIVE_FILTER_STRATEGY=B

# === Filter Toggle (true=aktif | false=bypass/nonaktif) ===
# Hanya berlaku jika ACTIVE_FILTER_STRATEGY=A
FILTER_F1_TRIGGER_ENABLED=true
FILTER_F2_SCORING_ENABLED=true
FILTER_F3_PATTERN_ENABLED=true
FILTER_MARKET_STATE_ENABLED=true
FILTER_EMA_SCORING_ENABLED=true

# =============================================
# === Filter B Specific Settings ===
# Eksekusi pullback (Pending Order) %
EXECUTION_OP_PCT_B=20
EXECUTION_SL_PCT_B=70
# Rasio TP dari SL (100% = 1:1)
EXECUTION_TP_PCT_B=100
# Ring Limit (Pts)
MIN_RING_C1_POINTS_B=250
MAX_RING_C1_POINTS_B=700

# Waktu kadaluwarsa Limit Order (dalam jumlah candle)
PENDING_ORDER_EXPIRE_CANDLES=2
# =============================================

# === Engulfing Thresholds ===
ENGULFING_MIN_BODY_RATIO=1.2
ENGULFING_MIN_BODY_PIPS=0.5
ENGULFING_EMA_BONUS=20
ENGULFING_RATIO_BONUS=15

# Panjang minimal ring C2 dalam point (harga mentah)
# Hijau: ring = Close - Low | Merah: ring = High - Close
ENGULFING_MIN_RING_POINTS=10

# Anti-Doji: minimal % body C2 terhadap full ring (High - Low = 100%)
# Body = |Close - Open|, Full Ring = High - Low
ENGULFING_MIN_BODY_RING_PCT=20

# === EMA Position Filter (syarat arah OP) ===
# BUY  : Close C2 harus di ATAS  EMA referensi
# SELL : Close C2 harus di BAWAH EMA referensi
ENGULFING_EMA_FILTER_ENABLED=true
ENGULFING_EMA_FILTER_SOURCE=slow

# === Polling ===
POLL_INTERVAL=1

# === Execution ===
EXECUTION_LOT_SIZE=0.01
EXECUTION_TP_POINTS=100
EXECUTION_SLIPPAGE=20
EXECUTION_MAGIC_NUMBER=777777

# === SL Buffer ===
# Persentase posisi SL di luar High/Low (default 105 = 5% di luar)
# Formula:
#   Candle Hijau (BUY)  : Range = Close - Low  -> SL = Low  - (Range * (SL_BUFFER_PERCENT-100)/100)
#   Candle Merah (SELL) : Range = High - Close -> SL = High + (Range * (SL_BUFFER_PERCENT-100)/100)
EXECUTION_SL_BUFFER_PERCENT=105
