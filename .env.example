# =====================================================
# .env.example - Template (copy ke .env lalu isi value)
# =====================================================

# === Supabase ===
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# === MT5 ===
MT5_SYMBOL=XAUUSD
MT5_TIMEFRAMES=M1,M5
STRATEGY_TIMEFRAME=M1
MT5_CANDLE_COUNT=50

# === EMA ===
EMA_FAST=10
EMA_SLOW=20
EMA_OFFSET=-2

# === Engulfing Thresholds ===
ENGULFING_MIN_BODY_RATIO=1.2
ENGULFING_MIN_BODY_PIPS=0.5
ENGULFING_EMA_BONUS=20
ENGULFING_RATIO_BONUS=15

# Panjang minimal ring C2 dalam point (harga mentah)
# Hijau: ring = Close - Low | Merah: ring = High - Close
ENGULFING_MIN_RING_POINTS=10

# Anti-Doji: minimal % body C2 terhadap full ring (High - Low = 100%)
# Body = |Close - Open|, Full Ring = High - Low
ENGULFING_MIN_BODY_RING_PCT=20

# === Polling ===
POLL_INTERVAL=1

# === Execution ===
EXECUTION_LOT_SIZE=0.01
EXECUTION_TP_POINTS=100
EXECUTION_SLIPPAGE=20
EXECUTION_MAGIC_NUMBER=777777

# === SL Buffer ===
# Persentase posisi SL di luar High/Low (default 105 = 5% di luar)
# Formula:
#   Candle Hijau (BUY)  : Range = Close - Low  -> SL = Low  - (Range * (SL_BUFFER_PERCENT-100)/100)
#   Candle Merah (SELL) : Range = High - Close -> SL = High + (Range * (SL_BUFFER_PERCENT-100)/100)
EXECUTION_SL_BUFFER_PERCENT=105
