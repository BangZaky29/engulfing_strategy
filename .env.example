# =====================================================
#   SYSTEM SCANNER & EXECUTION - CONFIGURATION (.env)
# =====================================================

# -----------------------------------------------------
# 1. CORE CONNECTIONS (Supabase)
# -----------------------------------------------------
SUPABASE_URL=-
SUPABASE_SERVICE_KEY=-
SUPABASE_ANON_KEY=-

# -----------------------------------------------------
# 2. METATRADER 5 (MT5) & SCANNER DEFAULTS
# -----------------------------------------------------
# MT5_SYMBOLS=BTC                       # Khusus Sabtu-Minggu
MT5_SYMBOLS=XAUUSD,NASDAQ-100,BTC      # Khusus Senin-Jumat
MT5_TIMEFRAMES=M5
STRATEGY_TIMEFRAME=M5
INFO_TIMEFRAMES=M15,H1

# Override timeframe per symbol (opsional)
# Jika diset, bot akan pakai TF ini untuk symbol tersebut.
# Jika tidak diset, bot akan pakai STRATEGY_TIMEFRAME.
TF_XAUUSD=M5
# TF_GBPUSD=M5
# TF_BTCUSD=M15
TF_NASDAQ-100=M5

MT5_CANDLE_COUNT=50
POLL_INTERVAL=1

# -----------------------------------------------------
# 3. EMA INDICATOR DEFAULTS
# -----------------------------------------------------
EMA_FAST=10
EMA_SLOW=20
EMA_OFFSET=-2

# -----------------------------------------------------
# 4. ACTIVE STRATEGY SELECTION
# -----------------------------------------------------
# A = Scoring & Grade
# B = Pullback Limit (No Grade)
ACTIVE_FILTER_STRATEGY=B

# -----------------------------------------------------
# 5. STRATEGY A CONFIGURATION (FILTER A)
# -----------------------------------------------------
# Only applied when ACTIVE_FILTER_STRATEGY=A
FILTER_F1_TRIGGER_ENABLED=true
FILTER_F2_SCORING_ENABLED=true
FILTER_F3_PATTERN_ENABLED=true
FILTER_MARKET_STATE_ENABLED=true
FILTER_EMA_SCORING_ENABLED=true

MIN_GRADE_ALLOWED=C+
ENGULFING_EMA_SOURCE=20

# Scoring weight distribution (total should be 100)
SCORE_WEIGHT_BODY=40
SCORE_WEIGHT_RANGE=30
SCORE_WEIGHT_EMA=20
SCORE_WEIGHT_CP=10
SCORE_BONUS_TREND=5
SCORE_PENALTY_SIDEWAYS=-15

# Ring C1 size thresholds for Strategy A
MIN_RING_C1_POINTS=100
NORMAL_RING_C1_POINTS=250
LARGE_RING_C1_POINTS=450
MAX_RING_C1_POINTS=1500

# Optional BTC ring settings examples
# MIN_RING_C1_POINTS=500
# NORMAL_RING_C1_POINTS=1200
# LARGE_RING_C1_POINTS=3000
# MAX_RING_C1_POINTS=7000

# MIN_RING_C1_POINTS=1000
# NORMAL_RING_C1_POINTS=2500
# LARGE_RING_C1_POINTS=5000
# MAX_RING_C1_POINTS=15000

EXECUTION_SL_PCT=80          # SL distance as % of C1 range
EXECUTION_TP_RR_RATIO=1.5    # TP target ratio

# -----------------------------------------------------
# 6. STRATEGY B CONFIGURATION (FILTER B)
# -----------------------------------------------------
# Only applied when ACTIVE_FILTER_STRATEGY=B
# true = aktifkan filter EMA untuk validasi trigger berada di atas/bawah EMA,
#        bukan untuk cross EMA.
FILTER_F3_EMA_RING_B_ENABLED=true
# true = aktifkan validasi ukuran ring C1 untuk Filter B.
# false = bypass semua skip karena pattern size pada Filter B.
FILTER_F2_PATTERN_B_ENABLED=false

EXECUTION_OP_PCT_B=20        # OP pullback distance (% dari C1)
EXECUTION_SL_PCT_B=105       # SL distance (% dari C1)
EXECUTION_TP_PCT_B=100       # TP target (% dari C1)

# Default fallback ring size for Strategy B
MIN_RING_C1_POINTS_B=5000
MAX_RING_C1_POINTS_B=25000

# Symbol-specific ring matrix for Strategy B
RING_B_XAUUSD_MIN=500
RING_B_XAUUSD_MAX=1000
# RING_B_GBPUSD_MIN=25
# RING_B_GBPUSD_MAX=180
# RING_B_BTCUSD_MIN=5000
# RING_B_BTCUSD_MAX=25000
RING_B_NASDAQ-100_MIN=2500
RING_B_NASDAQ-100_MAX=10000

PENDING_ORDER_EXPIRE_CANDLES=2

# -----------------------------------------------------
# 7. GENERAL ORDER EXECUTION SETTINGS
# -----------------------------------------------------
EXECUTION_LOT_SIZE=0.01
EXECUTION_USE_FIXED_MONEY=true
EXECUTION_FIXED_MONEY_USD=10.0
EXECUTION_SLIPPAGE=20
EXECUTION_MAGIC_NUMBER=777777

# -----------------------------------------------------
# 8. FILTER C - TF MONITOR (MULTI-TIMEFRAME)
# -----------------------------------------------------
FILTER_C_TFM_ENABLED=true

TFM_USE_ENGULFING=true
TFM_USE_MARUBOZU=true
TFM_USE_ICT=true
TFM_USE_PINBAR=true
TFM_USE_DOMINAN_BREAK=true
TFM_USE_MULTI_TRIGGER=true

TFM_USE_EMA_FILTER=true
TFM_EMA_PERIOD=20

TFM_MARUBOZU_WICK_BUFFER_POINTS=150
TFM_MARUBOZU_COMPARE_CANDLES=3
TFM_MARUBOZU_RANGE_MULTIPLIER=2.0

TFM_PINBAR_WICK_BODY_MULTIPLIER=4.0
TFM_PINBAR_MIN_RANGE_POINTS=600

TFM_DB_MIN_CANDLES=3
TFM_DB_MAX_CANDLES=20
TFM_DB_BUFFER_POINTS=0

TFM_TRIGGER_LOOKBACK_BARS=200

TFM_H1_LATE_AGE=5
TFM_STRONG_H1_MAX_AGE=0
TFM_STRONG_M15_MAX_AGE=3

TFM_BLOCKING=true

SL_H1_PCT=0.30
